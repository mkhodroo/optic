{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:mkhodroo/behin-simple-workflow.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:mkhodroo/inventory.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/mkhodroo/user-role.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:mkhodroo/bale-bot.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:mkhodroo/field-builder.git"
        },
        {
            "type": "vcs",
            "url": "git@github.com:mkhodroo/file-uploader.git"
        }
    ],
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-translation-manager": "^0.6.6",
        "firebase/php-jwt": "^6.11",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "^3.1",
        "melipayamak/php": "1.0.0",
        "morilog/jalali": "3.*",
        "phpoffice/phpword": "^1.4",
        "behin/simple-workflow": "dev-main",
        "arghavan/inventory": "dev-main",
        "arghavan/user-role": "dev-main",
        "arghavan/bale-bot": "dev-main",
        "arghavan/field-builder": "dev-main",
        "arghavan/file-control": "dev-main"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.0",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "BehinInit\\": "packages/behin-init/src/",
            "BehinUserRoles\\": "packages/behin-user-roles/src/",
            "UserProfile\\": "packages/behin-user-profile/src/",
            "BehinLogging\\": "packages/behin-logging/src/",
            "Behin\\Sms\\": "packages/behin-sms/src/",
            "Behin\\PMCaseNumbering\\": "packages/behin-pm-case-numbering/src/",
            "TodoList\\": "packages/behin-todo-list/src/",
            "FileService\\": "packages/behin-file-service/src/",
            "Behin\\SimpleWorkflowReport\\": "packages/behin-simple-workflow-report/src/",
            "TelegramBot\\": "packages/behin-telegram-bot/src/",
            "NumberToWord\\": "packages/number-to-word/src/",
            "ShortenerUrl\\Shortener\\": "packages/shortener-url/Shortener/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
